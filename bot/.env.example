# Snurp buyback bot — copy to .env and fill in. Never commit .env
SIGNER_KEY=0x...             # key of the BOT wallet only (a fresh wallet you set as fee recipient on Pons). Never the launch wallet.
PAYOUT_TO=0x...              # your main wallet; receives the 1% builder-tax share of every claim
BURN_SHARE_BPS=4118          # 0.7 / 1.7 of each claim is the pool-fee share and gets burned
TOKEN=0x1204bc9E2EdCED1eF6f0dE2b04eEB756ca43ab53
INTERVAL_MIN=10
MIN_CLAIM_ETH=0.0005
GAS_RESERVE_ETH=0.0005
SLIPPAGE_BPS=500
DRY_RUN=1                    # set to 0 to send real transactions
