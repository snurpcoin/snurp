# Snurp buyback bot — copy to .env and fill in. Never commit .env
SIGNER_KEY=0x...             # key of the creator fee wallet (the wallet that launched $SNURP)
TOKEN=0x...                  # $SNURP token address (from the Pons token page)
INTERVAL_MIN=10
MIN_CLAIM_ETH=0.0005
GAS_RESERVE_ETH=0.0005
SLIPPAGE_BPS=500
DRY_RUN=1                    # set to 0 to send real transactions
